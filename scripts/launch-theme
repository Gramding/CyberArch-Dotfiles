#!/usr/bin/env bash
set -euo pipefail

AGS_BIN="${HOME}/.local/bin/ags"
CORE_TS="${HOME}/.config/hypr/themes/cyberpunk/core.ts"

[ -x "$AGS_BIN" ] || exit 1

display="${WAYLAND_DISPLAY:-}"

if [ -z "$display" ]; then
    display="$(ls -t "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | head -1 | xargs -r basename || true)"
fi

[ -n "$display" ] || exit 1

# log to the per-user runtime dir (0700); a predictable /tmp path can be symlinked by another
# local user to make this clobber a file of theirs choosing that we can write
RUNDIR="${XDG_RUNTIME_DIR:-$HOME/.cache}/cyberpunk"
mkdir -p "$RUNDIR" 2>/dev/null || true
chmod 700 "$RUNDIR" 2>/dev/null || true

exec env WAYLAND_DISPLAY="$display" "$AGS_BIN" run --gtk 3 "$CORE_TS" >"$RUNDIR/cyberhypr-debug.log" 2>&1