#!/bin/sh
# reads package names on stdin and pokes the running HUD over its socket so the install bar pops up.
#
# NOT wired to anything by default. It used to run from a pacman hook, but a hook Execs as root and
# this script lives in the clone (user-writable), so anything that could write here — a user-level
# compromise, a rogue AUR package, or an upstream `git pull` — got root on the next `pacman -S`.
# The hook was removed for that reason.
#
# Do NOT point a /etc/pacman.d/hooks entry at this path. If you want the popup back, copy it to a
# root-owned location first and hook *that*:
#   sudo install -m 755 -o root -g root scripts/pkg-notify /usr/local/bin/cyberpunk-pkg-notify
# Then root only ever runs a file your user account cannot rewrite.

pkgs=$(cat | awk 'NF')
[ -z "$pkgs" ] && exit 0

n=$(printf '%s\n' "$pkgs" | grep -c .)
first=$(printf '%s\n' "$pkgs" | head -1)
ver=$(pacman -Q "$first" 2>/dev/null | awk '{print $2}')
tname=$(printf '%s' "$first" | cut -c1-16 | tr '[:lower:]' '[:upper:]')

if [ "$n" -gt 1 ]; then
    title="PACKAGES ADDED!"
    budget=22
    list=""; shown=0
    for p in $pkgs; do
        cand="$p"; [ -n "$list" ] && cand="$list, $p"
        if [ ${#cand} -le $budget ]; then list="$cand"; shown=$((shown + 1)); else break; fi
    done
    rem=$((n - shown))
    [ "$rem" -gt 0 ] && list="$list +$rem more"
    info="PKGS INSTALLED: $list"
else
    title="$tname INSTALLED!"
    info="$first  $ver"
fi

msg="pkg-installed ${title}|${info}"

# only this user's HUD — globbing /run/user/*/ leaked installed package names to every logged-in
# user's socket on a multi-user box.
SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/astal/cyberpunk.sock"
[ -S "$SOCK" ] || exit 0
printf '%s' "$msg" | socat - "UNIX-CONNECT:$SOCK" >/dev/null 2>&1
exit 0
